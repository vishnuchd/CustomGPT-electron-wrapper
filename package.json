{
  "name": "EasyBotChat",
  "version": "1.1.1",
  "description": "Secure application for accessing EasyBotChat",
  "repository": {
    "type": "git",
    "url": "https://github.com/vishnuchd/CustomGPT-electron-wrapper.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:publish": "electron-builder --publish always",
    "build:mac": "electron-builder --mac",
    "build:mac:publish": "electron-builder --mac --publish always",
    "build:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish=never",
    "build:mac:signed": "electron-builder --mac --publish=never",
    "build:mac:dist": "electron-builder --mac",
    "build:mac:signed:notarized": "bash scripts/sign-and-notarize.sh",
    "sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -SkipBuild",
    "sign:verbose": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -SkipBuild -Verbose",
    "check-notarization": "bash scripts/check-notarization-status.sh",
    "prepare-mac": "bash scripts/prepare-mac.sh",
    "upload:windows": "node scripts/upload-to-supabase.js",
    "download:windows": "node scripts/download-from-supabase.js",
    "build:win:upload": "npm run build && node scripts/upload-to-supabase.js"
  },
  "keywords": [
    "electron",
    "customgpt"
  ],
  "author": "EasyBotChat Inc. <support@easybot.chat>",
  "license": "MIT",
  "appId": "com.easybot.chat",
  "build": {
    "appId": "com.easybot.chat",
    "publish": [
      {
        "provider": "github",
        "owner": "vishnuchd",
        "repo": "customGPT-electron-release",
        "releaseType": "release"
      }
    ],
    "productName": "EasyBotChat",
    "files": [
      "main.js",
      "preload.js",
      "customizations.js",
      "EasyBotLogo.png"
    ],
    "directories": {
      "buildResources": "."
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "notarize": false
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "EasyBotLogo.png",
      "sign": "./scripts/sign-hook-windows.js",
      "certificateSubjectName": "EasyBotChat Inc."
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "msi": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "EasyBotLogo.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "appx": {
      "applicationId": "EasyBotChat",
      "identityName": "EasybotchatInc.EasyBotChat",
      "publisher": "CN=EASYBOTCHAT INC., O=EASYBOTCHAT INC., L=Dallas, S=Texas, C=US",
      "publisherDisplayName": "EASYBOTCHAT INC.",
      "displayName": "EasyBotChat",
      "languages": [
        "en-US"
      ],
      "makeappxArgs": []
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "dotenv": "^16.3.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-reload": "^2.0.0-alpha.1",
    "js-yaml": "^4.1.1"
  }
}